# syntax=docker/dockerfile:1
#
# RHEL 8 compatible build: compiled on Rocky Linux 8 (binary-compatible RHEL 8
# rebuild) with gcc-toolset-13, linked against RHEL 8's glibc 2.28 with
# libstdc++/libgcc statically linked. The result runs on RHEL 8.x, Rocky 8,
# AlmaLinux 8, Oracle Linux 8 and CentOS Stream 8 without extra packages.
#
#   docker build -f docker/Dockerfile.rhel8 --platform linux/amd64 \
#     --target artifact --output type=local,dest=out .
#
FROM quay.io/rockylinux/rockylinux:8 AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf -y install gcc-toolset-13-gcc-c++ gcc-toolset-13-binutils cmake make file \
 && dnf clean all

WORKDIR /src
COPY CMakeLists.txt ./
COPY third_party ./third_party
COPY src ./src
COPY tests ./tests

ARG VERSION=dev
ARG RUN_TESTS=1
RUN source /opt/rh/gcc-toolset-13/enable \
 && cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DPODLOGS_STATIC_STDLIB=ON \
      -DPODLOGS_VERSION="${VERSION}" \
 && cmake --build build -j"$(nproc)" \
 && if [ "${RUN_TESTS}" = "1" ]; then ./build/podlogs_tests; fi \
 && strip build/podlogs \
 && file build/podlogs \
 && echo "shared libraries:" && readelf -d build/podlogs | grep NEEDED \
 && max_glibc="$(objdump -T build/podlogs | grep -o 'GLIBC_[0-9.]*' | sed 's/GLIBC_//' | sort -uV | tail -1)" \
 && echo "newest glibc symbol version required: ${max_glibc} (RHEL 8 ships 2.28)" \
 && [ "$(printf '%s\n2.28\n' "${max_glibc}" | sort -V | tail -1)" = "2.28" ] \
 && ./build/podlogs --version

FROM scratch AS artifact
COPY --from=build /src/build/podlogs /podlogs
